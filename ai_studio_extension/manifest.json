{
  "manifest_version": 3,
  "name": "AutoGT Pro TikTok Extension",
  "version": "0.1.6",
  "description": "AutoGT Pro TikTok profile and channel bridge",
  "action": {
    "default_title": "AutoGT Pro TikTok Extension",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "alarms",
    "storage",
    "scripting",
    "tabs",
    "cookies",
    "nativeMessaging",
    "webRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.tiktok.com/*",
    "https://shop.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tiktok.com/*"
      ],
      "js": [
        "src/content/dom.js",
        "src/content/overlay.js",
        "src/content/tiktok.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
